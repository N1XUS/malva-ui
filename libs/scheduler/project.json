{
  "name": "scheduler",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/scheduler/src",
  "prefix": "mlv",
  "projectType": "library",
  "tags": ["scope:ui", "family:scheduler", "type:ui"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/scheduler/ng-package.json",
        "tsConfig": "libs/scheduler/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/scheduler/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        { "externalDependencies": ["typescript"] }
      ],
      "options": {
        "cwd": "libs/scheduler",
        "parallel": false,
        "commands": [
          "tsc --noEmit -p tsconfig.lib.json",
          "tsc --noEmit -p tsconfig.spec.json"
        ]
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "dependsOn": ["typecheck"],
      "options": {
        "config": "libs/scheduler/vite.config.mts"
      }
    }
  }
}
