{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/libs/core",
  "assets": [
    {
      "glob": "**/*",
      "input": "schematics",
      "output": "schematics"
    },
    {
      "glob": "{malva-ui.css,tokens.md}",
      "input": "styles",
      "output": "styles"
    }
  ],
  "lib": {
    "entryFile": "src/index.ts"
  },
  "allowedNonPeerDependencies": [
    "^@malva-ui/",
    "fast-equals",
    "lodash-es",
    "sortablejs"
  ]
}
